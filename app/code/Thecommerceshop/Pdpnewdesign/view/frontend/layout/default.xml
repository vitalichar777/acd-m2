    <body>
        <referenceContainer name="before.body.end">
            <block class="Magento\Framework\View\Element\Template" name="tcs.cart.drawer" template="Thecommerceshop_Pdpnewdesign::html/cart_drawer.phtml"/>
        </referenceContainer>
    </body>
</page>
