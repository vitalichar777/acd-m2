<script type="text/javascript">
require(['jquery', 'domReady!'], function ($) {
    var $wrap = $('.minicart-wrapper');
    if (!$wrap.length) { return; }
    var $backdrop = $('.tcs-cart-drawer-backdrop').first();

    var savedY = 0;

    function isOpen() { return $wrap.hasClass('active'); }
    function openDrawer() { if (!isOpen()) { savedY = window.pageYOffset || 0; $wrap.find('.action.showcart').trigger('click'); } }
    // Close via the dropdown widget's own API (idempotent). Fall back to toggling the trigger.
    function closeDrawer() {
        if (!isOpen()) { return; }
        var $panel = $('.block-minicart');
        try { $panel.dropdownDialog('close'); return; } catch (e) {}
        $wrap.find('.action.showcart').trigger('click');
    }

    // Capture the scroll position BEFORE the widget opens (header-icon clicks aren't routed through openDrawer).
    $wrap.on('mousedown', '.action.showcart', function () { if (!isOpen()) { savedY = window.pageYOffset || 0; } });

    // Keep the panel above the backdrop by hoisting it out of the header's stacking context.
    function sync() {
        var active = isOpen();
        document.body.classList.toggle('tcs-cart-open', active);
        $backdrop.toggleClass('is-open', active);
        if (active) {
            var panel = document.querySelector('.block-minicart');
            if (panel && panel.parentNode !== document.body) { document.body.appendChild(panel); }
            // Restore the pre-open scroll position (the mini-cart likes to scroll/focus on open).
            window.scrollTo(0, savedY);
            if (window.requestAnimationFrame) { requestAnimationFrame(function () { window.scrollTo(0, savedY); }); }
            // Only the backdrop / close button should close the drawer — kill the widget's outside-click close.
            $('body').off('click.outsideDropdown');
        } else {
            window.scrollTo(0, savedY);
        }
    }

    // The mini-cart's remove/qty handlers are delegated from .minicart-wrapper; because the panel is
    // hoisted to <body>, those no longer catch clicks. Re-delegate on document and call the sidebar
    // widget's own methods so remove / qty-update keep working.
    function sidebar() {
        var $mc = $('[data-block="minicart"]');
        var inst = $mc.data('mage-sidebar') || $mc.data('mageSidebar');
        if (!inst) { try { inst = $mc.sidebar('instance'); } catch (e) {} }
        return inst || null;
    }
    $(document).on('click', '.block-minicart .action.delete', function (e) {
        var sb = sidebar(); if (!sb) { return; }
        e.preventDefault(); e.stopPropagation();
        sb._removeItem($(this));
    });
    $(document).on('click', '.block-minicart .update-cart-item', function (e) {
        var sb = sidebar(); if (!sb) { return; }
        e.preventDefault(); e.stopPropagation();
        sb._updateItemQty($(this));
    });
    $(document).on('keyup', '.block-minicart .cart-item-qty', function () {
        var sb = sidebar(); if (sb && sb._showItemButton) { sb._showItemButton($(this)); }
    });
    $(document).on('focusout', '.block-minicart .cart-item-qty', function () {
        var sb = sidebar(); if (sb && sb._validateQty) { sb._validateQty($(this)); }
    });
    // After a remove / qty-update AJAX finishes, force the cart section to reload so the totals
    // (Products total / Discount / Subtotal) refresh in the drawer.
    $(document).on('ajaxComplete', function (e, xhr, settings) {
        var url = (settings && settings.url) || '';
        if (url.indexOf('sidebar/removeItem') !== -1 || url.indexOf('sidebar/updateItemQty') !== -1) {
            require(['Magento_Customer/js/customer-data'], function (customerData) {
                customerData.reload(['cart'], true);
            });
        }
    });

    // Checkout button always goes to the checkout page.
    var checkoutUrl = '<?= /* @noEscape */ $block->getUrl('checkout') ?>';
    $(document).on('click', '#top-cart-btn-checkout', function (e) {
        e.preventDefault();
        window.location.href = checkoutUrl;
    });

    // Open after any successful add-to-cart (site-wide).
    $(document).on('ajax:addToCart', function () { setTimeout(openDrawer, 50); });

    // Close ONLY via the backdrop or the close button.
    $backdrop.on('click', closeDrawer);
    $(document).on('click', '#btn-minicart-close', function (e) { e.preventDefault(); closeDrawer(); });
    if (window.MutationObserver) {
        new MutationObserver(sync).observe($wrap[0], { attributes: true, attributeFilter: ['class'] });
    }
});
</script>
