<div class="sticky-checkout hide">
    <div class="container">
        <div id="checkout_total_clone"><span class="price"></span></div>
        <?php
        $_product = $block->getProduct();
        $mapHelper = $this->helper('Thecommerceshop\Map\Helper\Data');
        $buttonTitle = __('Add to Cart'); ?>
        <?php if ($_product->isSaleable()): ?>
            <?php if(($mapHelper->getMapCategoryId() && in_array($mapHelper->getMapCategoryId(), $_product->getCategoryIds())) && (!$_product->getSpecialPrice() > 0)): ?>
                <?php /* Redesign: sticky bar shows a blue "Add to Cart" (buys directly via __tcsBuyNow) instead of the MAP "View Lowest Price" quickview. */ ?>
                <div id="quickview-<?php echo $_product->getId()?>" class="tcs-bt-quickview tcs-sticky-buy-wrap">
                    <a data-id="<?php echo $_product->getId()?>" class="tcs-sticky-buy btn btn-action action primary" href="javascript:void(0);" role="button">
                            <span><?php echo __('Add to Cart'); ?></span>
                    </a>
                </div>
            <?php else: ?>
                <div class="actions box-tocart">
                    <button type="button"
                            title="<?php /* @escapeNotVerified */ echo $buttonTitle ?>"
