                <span><?= /* @noEscape */ __('Out of stock') ?></span>
            </div>
        <?php endif; ?>
    </div>
</div>
<script type="text/javascript">
require([
    'jquery'
], function ($) {
    $(window).on('load',function(){
        var p_scrolled = false;
        var cartButton = '#product-addtocart-button';
        var QuickviewButton = '#quickview-'+<?php echo $_product->getId();?>;
        if($(QuickviewButton).length > 0){
            cartButton = QuickviewButton;
        }
        var offset = $(cartButton).length > 0 ? $(cartButton).offset().top : '0';
        $(window).scroll(function(){
            if(offset < $(window).scrollTop() && !p_scrolled){
                p_scrolled = true;
                // Redesign: show the green SALE price (from the "Today's Special Price" card) in the sticky
                // bar. Fall back to the configured/summary price for products that don't reveal a sale price.
                var $tcsSale = $('.tcs-price-card__sale').filter(function () {
                    var t = $.trim($(this).text());
                    return t !== '' && t !== ' ';
                }).first();
                // COMPARE-only (MAP) products expose the struck "Competitor Price" in .tcs-top-price__value.
                var $tcsCompare = $('.tcs-top-price__value').filter(function () { return /[0-9]/.test($(this).text()); }).first();
                var stickyCls, stickyPrice;
                if ($tcsSale.length) {
                    stickyCls = 'tcs-sticky-sale'; stickyPrice = $.trim($tcsSale.text());          // green, NOT struck
                } else if ($tcsCompare.length) {
                    stickyCls = 'tcs-sticky-compare'; stickyPrice = $.trim($tcsCompare.text());    // red, struck
                } else {
                    stickyCls = '';
                    stickyPrice = ($('.product-details .price-box .price').length > 0) ? $('.product-details .price-box .price').text() : $('.product-info-main .product-info-price .price-box .price').text();
                }
                $('#checkout_total_clone').html('Total: <span class="tcs-sticky-total '+stickyCls+'">'+$.trim(stickyPrice)+'</span>');
                $(".sticky-checkout").removeClass("hide");
                $(cartButton).off("DOMSubtreeModified").on("DOMSubtreeModified",function(){
                    $(cartButton+"-clone").html($(cartButton).html());
                    $(cartButton+"-clone").attr("class",$(cartButton).attr("class"));
                });
            }
            if(offset >= $(window).scrollTop() && p_scrolled){
                p_scrolled = false;
                $(".sticky-checkout").addClass("hide");
            }
        });
        $(cartButton+"-clone").click(function(){
            $(cartButton).trigger("click");
        });
        // Redesign sticky "Add to Cart": buy directly (same flow as the main blue ATC), no quickview popup.
        $(document).on('click', '.sticky-checkout .tcs-sticky-buy', function (e) {
            e.preventDefault();
            e.stopImmediatePropagation();
            if (typeof window.__tcsBuyNow === 'function') {
                window.__tcsBuyNow();
            } else {
                $('#product_addtocart_form').trigger('submit');
            }
        });
    });
    // positionign the page message based on new pdp layout
    $(document).ready(function() {
        if($('.catalog-product-view .page.messages') != undefined && $('.catalog-product-view #make_an_offer_show-popup') != undefined){
            $('.page.messages').insertBefore($('#make_an_offer_show-popup'));console.log('msg data');console.log($.trim($('.page.messages .messages').text())!= '');
            setTimeout(function() {
                if($.trim($('.page.messages .messages').text()) != ''){
                    $('html, body').scrollTop($('.page.messages').offset().top - 50);
                }
            }, 1000);
        }
    });
});
</script>
<style>
/* Sticky bar must sit ABOVE the site-reviews widget (#tbSiteReviews z-index 100000001) */
.sticky-checkout { z-index: 100000002 !important; }
/* Redesign: sticky bar "Add to Cart" — blue, matching the main product-page blue ATC. */
.sticky-checkout .tcs-sticky-buy,
.sticky-checkout .tcs-sticky-buy:hover,
.sticky-checkout .tcs-sticky-buy:focus,
.sticky-checkout .tcs-sticky-buy:active {
    display: flex !important; align-items: center; justify-content: center;
    width: 100%; box-sizing: border-box;
    background: #2F2BBC !important; color: #fff !important;
    border: 0 !important; border-radius: 8px;
    padding: 12px 16px !important; margin: 0 !important;
    font-family: 'Open Sans', sans-serif !important;
    font-size: 15px !important; font-weight: 600 !important; line-height: 1.2 !important;
    text-transform: uppercase; text-decoration: none !important;
}
.sticky-checkout .tcs-sticky-buy:hover { background: #262299 !important; }
/* Redesign: sticky bar total — green (not struck) for a sale, red struck for a compare-only price */
.sticky-checkout #checkout_total_clone .tcs-sticky-total { font-weight: 700; }
.sticky-checkout #checkout_total_clone .tcs-sticky-sale { color: #00973B !important; text-decoration: none !important; }
.sticky-checkout #checkout_total_clone .tcs-sticky-compare { color: #EE2D43 !important; text-decoration: line-through !important; }
</style>
