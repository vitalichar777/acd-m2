<script type="text/javascript">
require(['jquery', 'domReady!'], function ($) {
    var pid = <?= (int)$product->getId() ?>;
    var $val = $('.tcs-top-price__value[data-tcs-mirror-price="' + pid + '"]');
    if (!$val.length) { return; }
    // Mirror the "Competitor Price". Non-MAP products show the compare ("was") price here — the
    // actual sale price lives in the popup — so mirror the old price when present.
    function sync() {
        var $src = $('#old-price-configured-' + pid + ' .price').first();
        if (!$src.length) { $src = $('#product-price-' + pid + ' .price').first(); }
        if (!$src.length) { $src = $('.product-info-main .product-info-price .price-box .price').first(); }
        // only overwrite the server-side fallback when the live price actually has a value
        if ($src.length && $.trim($src.text()) !== '') { $val.html($src.html()); }
        // Mirror the shown "Competitor Price" into the bottom summary's price box when it has no live value.
        var shown = $val.html();
        $('.block-bundle-summary .price-configured_price .price').each(function () {
            if ($.trim($(this).text()) === '') { $(this).html(shown); }
        });
    }
    sync();
    setTimeout(sync, 300); setTimeout(sync, 1000); // catch the async priceBundle render
    var target = document.getElementById('product-price-' + pid);
    if (target && window.MutationObserver) {
        new MutationObserver(function () { sync(); })
            .observe(target, { childList: true, subtree: true, characterData: true });
    }
    // also re-mirror when the bottom summary price box re-renders
    var $bpb = $('.block-bundle-summary .price-configured_price').first();
    if ($bpb.length && window.MutationObserver) {
        new MutationObserver(function () { sync(); }).observe($bpb[0], { childList: true, subtree: true, characterData: true });
    }
    $(document).on('change', '#product_addtocart_form', function () { setTimeout(sync, 80); });
    // CTA (green "Unlock Lowest Price") -> only show the price popup; never add to cart.
    // The popup is shown by the popup script's delegated hover/click handlers; here we just
    // stop the anchor from navigating.
    $('.tcs-top-price__cta').on('click', function (e) {
        e.preventDefault();
    });
    // Heart -> reuse the existing wishlist link.
    $('.tcs-top-price__wish').on('click', function (e) {
        e.preventDefault();
        var $w = $('.product-info-main .product-addto-links .action.towishlist').first();
        if ($w.length) { $w[0].click(); }
    });
});
</script>
