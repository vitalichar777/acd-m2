<script type="text/javascript">
require(['jquery', 'domReady!'], function ($) {
    // Add the configured bundle to cart via the PDP form. The global cart drawer
    // (Thecommerceshop_Pdpnewdesign::html/cart_drawer.phtml) opens automatically on ajax:addToCart.
    window.__tcsBuyNow = function () {
        var $form = $('#product_addtocart_form');
        if (!$form.length) { return; }
        $form.trigger('submit'); // runs mage validation + catalogAddToCart AJAX
    };

    // Big blue CTA (the "View Lowest Price" quickview <a>): suppress the quickview popup and buy directly.
    // Capture phase runs before the document-delegated quickview handler, so stopping propagation prevents the popup.
    document.querySelectorAll('.block-bundle-summary .tcs-bt-quickview > a.tcs-quickview').forEach(function (el) {
        el.addEventListener('click', function (e) {
            e.preventDefault();
            e.stopImmediatePropagation();
            window.__tcsBuyNow();
        }, true);
    });
});
</script>

<script type="text/javascript">
require(['jquery', 'domReady!'], function ($) {
    // Accessories: default optional dropdown(s) to "Do not need one"; for a REQUIRED accessory option
    // with no "Do not need one", auto-select the first real option so the configured price is complete
    // and matches the collection-page price.
    $('.tcs-bundle-group--optional select.bundle-option-select').each(function () {
        var $sel = $(this);
        if ($sel.val()) { return; } // leave any pre-selected value alone
        var $dnn = $sel.find('option').filter(function () {
            return $.trim($(this).text()).toLowerCase().indexOf('do not need') === 0;
        }).first();
        if ($dnn.length) {
            $sel.val($dnn.val()).trigger('change');
        } else if ($sel.closest('.field.option').hasClass('required')) {
            var $first = $sel.find('option').filter(function () { return $.trim(this.value) !== ''; }).first();
            if ($first.length) { $sel.val($first.val()).trigger('change'); }
        }
    });

    // Show the heat-kit helper note under the "Heater" accessory option only (not every option).
    $('.tcs-bundle-group--optional .field.option').each(function () {
        var $opt = $(this);
        var label = $.trim($opt.find('> label.label, .label').first().text()).toLowerCase();
        if (label.indexOf('heat') !== -1 && !$opt.find('.tcs-optional-note').length) {
            $opt.append("<p class='tcs-optional-note'>Heat pumps lose efficiency below ~25&deg;F. A heat kit adds electric backup for the coldest days. Most homes this size choose 8&ndash;10 kW.</p>");
        }
    });

    // Warranty: show only 3 / 5 / 10 Year cards, and start with no selection.
    var $warr = $('.warranty_options');
    if ($warr.length) {
        $warr.find('.field.choice').each(function () {
            var $c = $(this);
            var name = $.trim($c.find('.product-name').text());
            if (!/^(3|5|10)\s*year/i.test(name)) { $c.addClass('tcs-warr-hide'); }
        });
        // mark the last visible card (10 Year) so it can span full width in the 2+1 layout
        $warr.find('.field.choice:not(.tcs-warr-hide)').last().addClass('tcs-warr-full');
        // clear any default-checked radio (e.g. "None") so nothing is selected by default
        $warr.find('input[type="radio"]:checked').prop('checked', false).trigger('change');
    }

    // Move the feature-list block (pdp_btmblk) to sit right below the Included group.
    var $feat = $('.product-info-main .pdp_btmblk').first();
    var $inc = $('.tcs-bundle-group--included').first();
    if ($feat.length && $inc.length) { $inc.after($feat); }

    // Warranty: clicking an already-selected card unselects it (radios normally can't be un-checked).
    // Bind to the CARD (so it fires for clicks on the label/price too) and capture the pre-click state.
    $(document).on('mousedown', '.warranty_options .field.choice', function () {
        var r = this.querySelector('input[type="radio"]');
        $(this).data('wasChecked', !!(r && r.checked));
    });
    $(document).on('click', '.warranty_options .field.choice', function () {
        if (!$(this).data('wasChecked')) { return; }
        $(this).data('wasChecked', false);
        var r = this.querySelector('input[type="radio"]');
        var $warr = $(this).closest('.warranty_options');
        // Defer so this wins over the browser default + priceBundle's own click/change handlers.
        setTimeout(function () {
            // Select the hidden "None" radio (value="") so priceBundle recalculates WITHOUT the warranty price.
            var $none = $warr.find('input[type="radio"]').filter(function () { return this.value === ''; }).first();
            if ($none.length) {
                $none.prop('checked', true).trigger('change');
            } else if (r) {
                r.checked = false; jQuery(r).trigger('change');
            }
        }, 0);
    });
});
</script>

