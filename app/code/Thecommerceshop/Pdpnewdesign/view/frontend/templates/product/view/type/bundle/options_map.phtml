<script type="text/javascript">
require(['jquery', 'domReady!'], function ($) {
    var pid = <?= (int)$product->getId() ?>;
    var $popup = $('.tcs-price-popup');
    if (!$popup.length) { return; }
    var $cta = null, hideTimer = null;

    function money(n) { return '$' + n.toLocaleString('en-US', {minimumFractionDigits:2, maximumFractionDigits:2}); }

    function num(txt) { return parseFloat((txt || '').replace(/[^0-9.]/g, '')); }

    function compute() {
        var $mp = $('.tcs-map-data .mPrice');
        var disvalue = $mp.length ? parseFloat($mp.attr('data-disvalue')) : NaN;

        // MAP product: hidden "lowest price" discount from map_discount.
        // base = regular - warranties; save = pct ? base*disvalue/100 : base-disvalue; sale = base - save + warranties.
        if ($mp.length && !isNaN(disvalue) && disvalue > 0) {
            var distype = parseInt($mp.attr('data-distype'), 10) || 1;
            var $reg = $('#product-price-' + pid + ' .price').first();
            var regular = $reg.length ? num($reg.text()) : parseFloat($mp.attr('data-price'));
            if (isNaN(regular) || regular <= 0) { return null; }
            var warranties = 0;
            $('.warranty_options input[type="radio"]:checked, .warranty_options input[type="checkbox"]:checked').each(function () {
                var pc = $(this).closest('.field.choice').find('.price-container [data-price-amount]');
                if (pc.length) { var p = parseFloat(pc.attr('data-price-amount')); if (!isNaN(p)) { warranties += p; } }
            });
            var base = regular - warranties;
            var save = (distype === 1) ? (base * disvalue / 100) : (base - disvalue);
            if (save < 0) { save = 0; }
            var sale = base - save + warranties;
            var pct = (distype === 1) ? Math.round(disvalue) : Math.round(save / regular * 100);
            return { regular: regular, sale: sale, save: save, pct: pct };
        }

        // Non-MAP product: use the live bundle price box — sale = configured (final) price, compare = "was" (old) price.
        var saleN = num($('#product-price-' + pid + ' .price').first().text());
        var regN = num($('#old-price-configured-' + pid + ' .price').first().text());
        if (isNaN(saleN) || saleN <= 0) { return null; }
        if (isNaN(regN) || regN < saleN) { regN = saleN; }
        var saveN = regN - saleN;
        var pctN = regN > 0 ? Math.round(saveN / regN * 100) : 0;
        return { regular: regN, sale: saleN, save: saveN, pct: pctN };
    }

    function fill() {
        var d = compute();
        if (!d) { return false; }
        $popup.find('.tcs-price-popup__reg').text(money(d.regular));
        $popup.find('.tcs-price-popup__sale').text(money(d.sale));
        $popup.find('.tcs-price-popup__save').text(d.pct + '% (' + money(d.save) + ')');
        return true;
    }

    function position() {
        if (!$cta || !$cta.length) { return; }
        var r = $cta[0].getBoundingClientRect();

        // Mobile: drop the popup directly below the button, matching its width, with a small gap.
        if (window.innerWidth <= 767) {
            $popup.removeClass('tcs-price-popup--right').addClass('tcs-price-popup--below');
            $popup.css({ left: r.left + 'px', width: r.width + 'px', top: (r.bottom + 8) + 'px' });
            return;
        }

        $popup.removeClass('tcs-price-popup--below').css('width', '');
        var pw = $popup.outerWidth(), ph = $popup.outerHeight();
        var left = r.left - pw - 14;
        $popup.removeClass('tcs-price-popup--right');
        if (left < 8) { left = r.right + 14; $popup.addClass('tcs-price-popup--right'); } // flip to the right if no room on the left
        var top = r.top + r.height / 2 - ph / 2;
        if (top < 8) { top = 8; }
        $popup.css({ left: left + 'px', top: top + 'px' });
    }

    function show() { clearTimeout(hideTimer); if (fill()) { $popup.css('display', 'block'); position(); } }
    function hide() { $popup.css('display', 'none'); }

    // MAP / hidden-price template: the price is NOT revealed in a popup. The green "Unlock Lowest Price"
    // pills (top + bottom) smooth-scroll to the main Add-to-Cart button instead. The popup is disabled.
    var GREEN_SEL = '.tcs-top-price__cta';
    if ($popup.length) { $popup.remove(); }
    function scrollToATC() {
        var $atc = $('.tcs-mainbtn, .block-bundle-summary .tcs-bt-quickview > a, #product-addtocart-button, .product-add-form .box-tocart .action.tocart')
            .filter(':visible').first();
        if (!$atc.length) { return; }
        // center the Add-to-Cart button in the viewport
        var target = $atc.offset().top - (window.innerHeight / 2) + ($atc.outerHeight() / 2);
        $('html, body').stop().animate({ scrollTop: Math.max(0, target) }, 400);
        $atc.addClass('tcs-atc-flash');
        setTimeout(function () { $atc.removeClass('tcs-atc-flash'); }, 1200);
    }
    $(document).on('click', GREEN_SEL, function (e) { e.preventDefault(); e.stopImmediatePropagation(); scrollToATC(); });
});
</script>

