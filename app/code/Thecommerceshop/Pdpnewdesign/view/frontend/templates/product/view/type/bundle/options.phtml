<?php $includedOpt = $optionalOPt = $warrantyOpt = $fullOpt = '';
            foreach ($options as $option) : ?>
                <?php
                if (!$option->getSelections()) {
                    continue;
                } else {
                    if((count($option->getSelections()) == 1) && $option->getRequired()){
                        $includedOpt .=  $block->getOptionHtml($option);
                    }elseif($Warrantyhelper->validateWarrantyCategory($option->getId()) === true){
                        $warrantyOpt .= $block->getOptionHtml($option);
                    }else{
                        $optionalOPt .=  $block->getOptionHtml($option);
                    }
                }
                ?>
            <?php endforeach; ?>
