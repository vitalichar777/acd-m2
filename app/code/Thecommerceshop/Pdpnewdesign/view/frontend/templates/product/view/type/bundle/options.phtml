<script type="text/javascript">
require(['jquery', 'domReady!'], function ($) {
    // Bottom main CTA "Add to Cart to Get Lowest Price".
    // NOTE: the arrow is an <i> (not <span>) so Porto's add-to-cart loader — which does
    // button.find('span').text('Adding...') — only hits the single text span (no "Adding... Adding...").
    var MAINBTN_HTML =
        '<span class="tcs-mainbtn__text">Add to Cart <b class="tcs-mainbtn__b">to Get Lowest Price</b></span>' +
        '<i class="tcs-mainbtn__arrow"><svg xmlns="http://www.w3.org/2000/svg" width="25" height="12" viewBox="0 0 25 12" fill="none"><path d="M24.5303 6.05328C24.8232 5.76039 24.8232 5.28551 24.5303 4.99262L19.7574 0.219648C19.4645 -0.073245 18.9896 -0.073245 18.6967 0.219648C18.4038 0.512542 18.4038 0.987415 18.6967 1.28031L22.9393 5.52295L18.6967 9.76559C18.4038 10.0585 18.4038 10.5334 18.6967 10.8263C18.9896 11.1191 19.4645 11.1191 19.7574 10.8263L24.5303 6.05328ZM0 5.52295V6.27295H24V5.52295V4.77295H0V5.52295Z" fill="white"/></svg></i>';
    // MAP products: retext the summary "View Lowest Price" quickview into the primary blue button.
    var $vlp = $('.block-bundle-summary .tcs-bt-quickview > a.tcs-quickview').first();
    if ($vlp.length) {
        if (!$vlp.hasClass('tcs-mainbtn')) { $vlp.addClass('tcs-mainbtn').html(MAINBTN_HTML); }
    } else {
        // Non-MAP products: give the standard Add-to-Cart button the SAME look/label, and mark the
        // page so the bottom price section mirrors the MAP layout (compare price only; sale in popup).
        document.body.classList.add('tcs-nonmap-bundle');
        var $atc = $('.product-add-form .box-tocart .action.tocart').first();
        if ($atc.length && !$atc.hasClass('tcs-mainbtn')) { $atc.addClass('tcs-mainbtn').html(MAINBTN_HTML); }
    }

    // The theme's add-to-cart cycle rewrites the button's single span 'Adding...' -> 'Added' -> 'Add to
    // Cart' (dropping our two-tone label + arrow). Watch the button and restore the exact original once
    // the cycle finishes (no longer .disabled and the <b> label is gone). The arrow is hidden via CSS
    // while .disabled is set.
    $('.tcs-mainbtn').each(function () {
        if (this.__tcsBtnObserved || !window.MutationObserver) { return; }
        this.__tcsBtnObserved = true;
        var btn = this;
        new MutationObserver(function () {
            var $b = $(btn);
            if (!$b.hasClass('disabled') && !$b.find('.tcs-mainbtn__b').length) { $b.html(MAINBTN_HTML); }
        }).observe(btn, { childList: true, subtree: true, attributes: true, attributeFilter: ['class'] });
    });

    // Bottom price row: inject the "Today's Special Price" card, and move the affirm widget below it (above the ATC).
    var $details = $('.block-bundle-summary .product-details').first();
    if ($details.length && !$details.children('.tcs-bottom-card').length) {
        var $card = $(
            '<div class="tcs-price-block tcs-bottom-card">' +
              '<div class="tcs-price-card"><span class="tcs-price-card__label">Today\'s Special Price</span><span class="tcs-price-card__sale">&nbsp;</span></div>' +
              '<span class="tcs-price-card__compare"></span>' +
            '</div>'
        );
        $details.children('.price-box.price-configured_price').first().after($card);
        var $affirm = $('.tcs-affirm-slot').first();
        if ($affirm.length) { $card.after($affirm); }
        if (window.__tcsRenderCards) { window.__tcsRenderCards(); }
    }

    // Bottom compare button: give it the bar-chart icon (MAP + non-MAP).
    var $cmp = $('.block-bundle-summary .action.tocompare').first();
    if ($cmp.length && !$cmp.find('svg').length) {
        $cmp.prepend('<svg xmlns="http://www.w3.org/2000/svg" width="18" height="20" viewBox="0 0 18 20" fill="none"><path d="M15.375 0C14.3395 0 13.5 0.839466 13.5 1.875V17.625C13.5 18.6605 14.3395 19.5 15.375 19.5H16.125C17.1605 19.5 18 18.6605 18 17.625V1.875C18 0.839466 17.1605 0 16.125 0H15.375Z" fill="#333333"/><path d="M6.75 6.375C6.75 5.33947 7.58947 4.5 8.625 4.5H9.375C10.4105 4.5 11.25 5.33947 11.25 6.375V17.625C11.25 18.6605 10.4105 19.5 9.375 19.5H8.625C7.58947 19.5 6.75 18.6605 6.75 17.625V6.375Z" fill="#333333"/><path d="M0 10.875C0 9.83947 0.839466 9 1.875 9H2.625C3.66053 9 4.5 9.83947 4.5 10.875V17.625C4.5 18.6605 3.66053 19.5 2.625 19.5H1.875C0.839466 19.5 0 18.6605 0 17.625V10.875Z" fill="#333333"/></svg>');
    }

    // Move the financing banners to sit right after the "Found a better price" block.
    var $fbp = $('.product-info-main #make_an_offer_show-popup').first();
    var $fin = $('.product-info-main .tcs-fin-banners').first();
    if ($fbp.length && $fin.length && !$fbp.next().is('.tcs-fin-banners')) {
        $fbp.after($fin);
    }

    // Sizing Help: move into the bottom price row (after compare), relabel to "Sizing Help".
    var $sizing = $('#sizing_calc_button');
    if ($sizing.length && $details.length && !$details.children('#sizing_calc_button').length) {
        $sizing.find('.tcs-sizingcalc span').text('Sizing Help');
        var $addto = $details.children('.product-addto-links').first();
        if ($addto.length) { $addto.after($sizing); } else { $details.append($sizing); }
    }
});
</script>
