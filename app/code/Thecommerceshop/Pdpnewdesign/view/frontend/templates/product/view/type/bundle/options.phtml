<script type="text/javascript">
require(['jquery', 'domReady!'], function ($) {
    var pid = <?= (int)$product->getId() ?>;
    var $block0 = $('.tcs-price-block');
    if (!$block0.length) { return; }

    // First paint uses the server baseline (matches the collection card). Once the customer actually
    // changes an option, `userTouched` flips and the card follows the live configured price.
    var baseReg  = parseFloat($block0.attr('data-base-regular'));
    var baseSale = parseFloat($block0.attr('data-base-sale'));
    var userTouched = false;

    function money(n) { return '$' + n.toLocaleString('en-US', {minimumFractionDigits:2, maximumFractionDigits:2}); }

    function num(txt) { return parseFloat((txt || '').replace(/[^0-9.]/g, '')); }

    function compute() {
        var $mp = $('.tcs-map-data .mPrice');
        var disvalue = $mp.length ? parseFloat($mp.attr('data-disvalue')) : NaN;

        // MAP product: hidden "lowest price" discount from map_discount.
        // base = regular - warranties; save = pct ? base*disvalue/100 : base-disvalue; sale = base - save + warranties.
        if ($mp.length && !isNaN(disvalue) && disvalue > 0) {
            var distype = parseInt($mp.attr('data-distype'), 10) || 1;
            var $reg = $('#product-price-' + pid + ' .price').first();
            var regular = $reg.length ? num($reg.text()) : parseFloat($mp.attr('data-price'));
            if (isNaN(regular) || regular <= 0) { return null; }
            var warranties = 0;
            $('.warranty_options input[type="radio"]:checked, .warranty_options input[type="checkbox"]:checked').each(function () {
                var pc = $(this).closest('.field.choice').find('.price-container [data-price-amount]');
                if (pc.length) { var p = parseFloat(pc.attr('data-price-amount')); if (!isNaN(p)) { warranties += p; } }
            });
            var base = regular - warranties;
            var save = (distype === 1) ? (base * disvalue / 100) : (base - disvalue);
            if (save < 0) { save = 0; }
            var sale = base - save + warranties;
            var pct = (distype === 1) ? Math.round(disvalue) : Math.round(save / regular * 100);
            return { regular: regular, sale: sale, save: save, pct: pct };
        }

        // Non-MAP product: use the live bundle price box — sale = configured (final) price, compare = "was" (old) price.
        var saleN = num($('#product-price-' + pid + ' .price').first().text());
        var regN = num($('#old-price-configured-' + pid + ' .price').first().text());
        if (isNaN(saleN) || saleN <= 0) { return null; }
        if (isNaN(regN) || regN < saleN) { regN = saleN; }
        var saveN = regN - saleN;
        var pctN = regN > 0 ? Math.round(saveN / regN * 100) : 0;
        return { regular: regN, sale: saleN, save: saveN, pct: pctN };
    }

    // Render the "Today's Special Price" blocks (top + bottom) with the live sale + compare price.
    function renderCards() {
        // Before the customer touches an option, show the server baseline (matches the collection card).
        // After, follow the live configured price so it reflects their real selections.
        var d;
        if (userTouched) {
            d = compute();
        } else if (!isNaN(baseSale) && baseSale > 0) {
            d = { regular: baseReg, sale: baseSale, save: (baseReg - baseSale), pct: 0 };
        } else {
            d = compute(); // fallback if the server baseline is missing
        }
        var $blocks = $('.tcs-price-block');
        if (!d) { $blocks.css('visibility', 'hidden'); return; }
        $blocks.css('visibility', 'visible');
        $('.tcs-price-card__sale').text(money(d.sale));
        $('.tcs-price-card__compare').text(d.regular > d.sale ? money(d.regular) : '');
    }
    window.__tcsRenderCards = renderCards;
    renderCards();
    var target = document.getElementById('product-price-' + pid);
    if (target && window.MutationObserver) {
        new MutationObserver(function () { renderCards(); })
            .observe(target, { childList: true, subtree: true, characterData: true });
    }
    // The customer physically engaging the option controls (mouse / touch / keyboard) switches the
    // card from the server baseline to the LIVE configured price. Programmatic defaults set on load
    // (the optional "Do not need one" auto-set, warranty reset, priceBundle init) fire no such
    // interaction, so the baseline holds until the customer actually starts choosing.
    $(document).on('mousedown touchstart keydown',
        '#product-options-wrapper, .bundle-options-wrapper, .warranty_options', function () {
        userTouched = true;
    });
    $(document).on('change', 'select.bundle-option-select, .warranty_options input', function () {
        if (userTouched) { setTimeout(renderCards, 80); }
    });
});
</script>

