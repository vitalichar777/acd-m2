                //             var optionId = optionIdMatch[1];
                //             var selectedValue = selectionList[key];

                //             // Find and check the appropriate radio button
                //             if (selectedValue) { console.log('selected value');console.log(selectedValue);
                //                 // Select the specific option
                //                 var radioSelector = '.tcs_quickview-catalog_product-view .bundle-options-wrapper #product-options-wrapper .field.option input[name="bundle_option[' + optionId + ']"][value="' + selectedValue + '"]';
                //                 console.log(radioSelector);
                //                 $(radioSelector).prop('checked', true).trigger('change');
                //             } else {
                //                 // Select the "None" option
                //                 var noneRadioSelector = '.tcs_quickview-catalog_product-view .bundle-options-wrapper #product-options-wrapper .field.option input[name="bundle_option[' + optionId + ']"][value=""]';
                //                 $(noneRadioSelector).prop('checked', true).trigger('change');
                //             }
                //         }
                //     }
                // }

                var PriceBoxDiv = $('.tcs_quickview-catalog_product-view .product-info-main .product-info-price .price-box.price-final_price');
                PriceBoxDiv.attr('style', 'display: none !important');
            }
