<script>
require(['jquery'], function($) {
    $(document).ready(function() {
        // Handle tooltip popup click
        $(document).on('click', '.tooltip-icon', function(e) {
            e.preventDefault();
            e.stopPropagation();
            
            // Open the modal using jQuery
            $('#warranty-tooltip-modal').modal('openModal');
        });
    });
});
</script>

<style>
/* Mobile spacing overrides — placed last so they win over all base rules above */
@media (max-width: 767.98px) {
    .tcs-bundle-group__body { padding: 10px; }
    .warranty_options .field.choice { padding: 7px; }
    .warranty_options .field.choice .tooltip-popup { right: 3px; bottom: 11px; padding: 2px; font-size: 8px !important; }
}
</style>

