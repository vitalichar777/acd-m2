$product = $block->getProduct();

$categoryIds = $product->getCategoryIds();
$warrantyStatus = false;
if($categoryIds && count($categoryIds)>0){
    $Warrantyhelper = $this->helper(Thecommerceshop\Warranty\Helper\Data::class);
    $warrantyStatus = $Warrantyhelper->getWarrantyStatus($categoryIds);
}

$helper = $this->helper(Magento\Catalog\Helper\Output::class);
$stripSelection = $product->getConfigureMode() ? true : false;
