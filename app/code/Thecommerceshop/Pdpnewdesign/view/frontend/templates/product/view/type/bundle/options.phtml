                if($warrantyStatus === true){
                    $fullOpt .= ($warrantyOpt == '') ? $warrantyOpt : "<div data-role='collapsible' class='collapsible_title'>3<sup>rd</sup> Party Extended Labor Warranty
<span class='tooltip-container'>
<span class='tooltip-icon'>?</span>
<!--<span class='tooltip-text'>". $this->getLayout()->createBlock('Magento\Cms\Block\Block')->setBlockId('warranty_policy_link')->toHtml()."</span>-->
</span>
<div data-role='trigger' class='collapsible_icon'></div></div><div data-role='content' class='option_optional warranty_options'>".$warrantyOpt."</div>";
                }?>
                <div data-mage-init='{"accordion":{"openedState": "active", "collapsible": true, "active":[1, 2], "multipleCollapsible": true}}'>
                    <?php echo $fullOpt; ?>
                </div>
        </fieldset>
    <?php else : ?>
        <p class="empty"><?= $block->escapeHtml(__('No options of this product are available.')) ?></p>
    <?php endif; ?>
<?php endif;?>
<script type="text/javascript">
        require([
            'jquery','domReady!'
        ], function ($) {
            if($('body').hasClass('tcs_quickview-catalog_product-view')) {
                var selectionList = parent.window.BundleList;

                // Handle dropdown selects
                var CurrentselectionList = $('.tcs_quickview-catalog_product-view .bundle-options-wrapper #product-options-wrapper .field.option select');
                if(Object.keys(selectionList).length > 0){
                    CurrentselectionList.each(function(){
                        this.selectedIndex = selectionList[this.id];
                    });
                    // Show price configuration and hide regular price box
                    var ConfigPriceDiv = $('.tcs_quickview-catalog_product-view .price-configured_price .price-as-configured');
                    ConfigPriceDiv.addClass('show');
                    ConfigPriceDiv.removeClass('hide');
                }

                // Dynamically get optionId and selectionId for radio bundle options from window.BundleList
                var optionId = null;
                var selectionId = null;
                var selectionList = parent.window.BundleList || {};
                var $checkedRadio = $('.tcs_quickview-catalog_product-view .bundle-options-wrapper #product-options-wrapper .field.option .radio:checked').first();
                if ($checkedRadio.length) {
                    var nameAttr = $checkedRadio.attr('name'); // e.g., bundle_option[13031]
                    var match = nameAttr.match(/\[(\d+)\]/);
                    if (match) {
                        optionId = match[1];
                        selectionId = selectionList['bundle-option-' + optionId];
                    }
                }

                var attempts = 0;
                var maxAttempts = 15;
                var interval = setInterval(function () {
                var $radio = $('input[name="bundle_option[' + optionId + ']"][value="' + selectionId + '"]');
                var $form = $('#product_addtocart_form');
                var widgetInstance = $form.data('mage-priceBundle');

                if ($radio.length && widgetInstance) {
                // 1. Select the desired radio button
                $radio.prop('checked', true).trigger('change');

                // 2. Force the bundle widget to recalculate price
                if (typeof widgetInstance.reloadPrice === 'function') {
                widgetInstance.reloadPrice();
                console.log('Bundle price updated successfully!');
                clearInterval(interval);
            } else {
                console.warn('reloadPrice is not a function on widget instance.');
            }
        } else {
            console.log('Waiting for widget or radio to be available...');
        }

        if (++attempts >= maxAttempts) {
            clearInterval(interval);
            console.error('Timeout: Could not auto-select bundle option.');
        }
    }, 300);
