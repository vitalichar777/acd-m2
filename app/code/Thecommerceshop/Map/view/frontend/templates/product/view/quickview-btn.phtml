        <script type="text/javascript">
            require(['jquery','domReady!'], function ($) {
                $('body').addClass('tcs-simple-map-pdp');
                // reuse the native wishlist / compare actions
                $('.tcs-top-price__wish').on('click', function (e) {
                    e.preventDefault();
                    var $w = $('.product-info-main .action.towishlist, .action.towishlist').first();
                    if ($w.length) { $w[0].click(); }
                });
                $('.tcs-top-price__compare').on('click', function (e) {
                    e.preventDefault();
                    var $c = $('.product-info-main .action.tocompare, .action.tocompare').first();
                    if ($c.length) { $c[0].click(); }
                });
                // Blue CTA: add to cart directly instead of showing the old quickview popup. Capture phase
                // runs before the document-delegated quickview handler, so the popup is suppressed; the
                // global cart drawer opens automatically on ajax:addToCart.
                document.querySelectorAll('.tcs-simple-cta > a.tcs-quickview').forEach(function (el) {
                    el.addEventListener('click', function (e) {
                        e.preventDefault();
                        e.stopImmediatePropagation();
                        var $form = $('#product_addtocart_form');
                        if ($form.length) { $form.trigger('submit'); } // mage validation + catalogAddToCart AJAX
                    }, true);
                });
            });
        </script>
        <?php else: ?>
        <div id="quickview-<?php echo $_product->getId()?>" class="tcs-bt-quickview">
            <a data-id="<?php echo $_product->getId()?>" class="tcs-quickview btn btn-action action primary" data-quickview-url="<?php echo $mapHelper->getBaseUrl(); ?>tcs_quickview/catalog_product/view/id/<?php echo $_product->getId()?>" href="javascript:void(0);">
                <span><?php echo $buttontext; ?></span>
            </a>
