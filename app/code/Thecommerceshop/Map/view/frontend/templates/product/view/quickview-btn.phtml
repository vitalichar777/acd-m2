        <?php $buttontext = $mapHelper->getAddToCartText(); ?>
        <?php if ($tcsIsSimple):
            /* Simple MAP product: mirror the bundle/card price logic — Goodman/Daikin/MrCool reveal the sale
               (green "Today's Special Price" + struck compare); all other brands show "Competitor Price". */
            $tcsReg = (float)$_product->getPriceInfo()->getPrice('regular_price')->getAmount()->getValue();
            $tcsOpen = (stripos($_product->getName(), 'goodman') !== false) || (stripos($_product->getName(), 'daikin') !== false) || (stripos($_product->getName(), 'mrcool') !== false);
            $tcsIsMap = ($mapHelper->getMapCategoryId() && in_array($mapHelper->getMapCategoryId(), $_product->getCategoryIds())) && (!$_product->getSpecialPrice() > 0);
            $tcsSale = $tcsIsMap ? (float)$mapHelper->getRuleDiscountforCustomAmount($_product->getId(), $tcsReg) : (float)$_product->getPriceInfo()->getPrice('final_price')->getAmount()->getValue();
            $tcsHasSale = ($tcsSale > 0 && $tcsSale < $tcsReg);
        ?>
        <div class="tcs-top-price tcs-simple-top">
            <div class="tcs-top-price__info">
                <?php if ($tcsOpen): ?>
                    <span class="tcs-top-price__label tcs-top-price__label--sale">Today's Special Price</span>
                    <span class="tcs-top-price__saleline">
                        <span class="tcs-top-price__sale"><?= /* @noEscape */ $priceHelper->currency($tcsHasSale ? $tcsSale : $tcsReg, true, false) ?></span>
                        <?php if ($tcsHasSale): ?><span class="tcs-top-price__was"><?= /* @noEscape */ $priceHelper->currency($tcsReg, true, false) ?></span><?php endif; ?>
                    </span>
                <?php else: ?>
                    <span class="tcs-top-price__label">Competitor Price</span>
                    <span class="tcs-top-price__value"><?= /* @noEscape */ $priceHelper->currency($tcsReg, true, false) ?></span>
                <?php endif; ?>
            </div>
            <a href="javascript:void(0);" class="tcs-top-price__compare" role="button" aria-label="Add to Compare">
