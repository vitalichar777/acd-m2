<?xml version="1.0"?>

<page layout="1column" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd" ifconfig="tcs_quickview/general/enable_product_listing">
    <update handle="catalog_product_view" />
    <update handle="catalog_delivery_info"/>
    <body>
        <referenceBlock name="header.container" remove="true" />
        <referenceBlock name="page.top" remove="true" />
        <referenceBlock name="footer-container" remove="true" />
        <referenceContainer name="head" remove="true"/>
        <referenceContainer name="header" remove="true"/>
        <referenceContainer name="menu" remove="true"/>
		<referenceContainer name="tcs.demo.notices" remove="true"/>
        <referenceContainer name="footer" remove="true"/>
        <referenceBlock name="copyright" remove="true" />
        <referenceBlock name="authentication-popup" remove="true" />
        <!-- <referenceBlock name="page.messages" remove="true" /> -->
        <referenceContainer name="content">
            <block class="Magento\Catalog\Block\Product\View\Type\Simple" ifconfig="tcs_quickview/general/enable_goto_product_button" name="goto.product" template="Thecommerceshop_Map::gotoproduct.phtml" before="-" />
            <block class="Thecommerceshop\Map\Block\Product\View" name="product.rules" template="Thecommerceshop_Map::product/view/rules.phtml" after="product.price.final" />
        </referenceContainer>
        <referenceContainer name="before.body.end">
            <block class="Thecommerceshop\Map\Block\Initialize" name="tcs.quickview.beforebodyend" template="Thecommerceshop_Map::beforebodyend.phtml" />
            <block class="Thecommerceshop\Map\Block\Product\View" name="mfp-footer" template="Thecommerceshop_Map::footer.phtml" />
        </referenceContainer>
        <referenceBlock name="product.info.addtocart" class="Thecommerceshop\Map\Block\Product\View" template="Thecommerceshop_Map::product/view/addtocart.phtml">
        </referenceBlock>
        <referenceBlock name="product.info.addtocart.additional" class="Thecommerceshop\Map\Block\Product\View" template="Thecommerceshop_Map::product/view/addtocart.phtml">
        </referenceBlock>
        <move element="product.rules" destination="product.info.price" after="product.price.final"/>

        <!-- Remove depends on your theme -->
        <referenceBlock name="porto_header" remove="true" />
        <referenceBlock name="top.line" remove="true" />
        <referenceBlock name="prev_next_products" remove="true" />
        <referenceContainer name="sidebar.main" remove="true" />
        <referenceContainer name="sidebar.additional" remove="true" />
        <referenceBlock name="info_tabs" remove="true"/>
        <referenceContainer name="product.info.social" remove="true"/>
        <referenceBlock name="product_view_custom_block" remove="true"/>
        <referenceBlock name="product.quickview.btn" remove="true" />
        <referenceBlock name="product.quickview.btn.bundle" remove="true" />
        <referenceBlock name="olark.chatbox" remove="true" />
        <referenceBlock name="tracking-product-review" remove="true" />
        <referenceBlock name="tb-tracking" remove="true" />
        <referenceBlock name="shipping_feature" remove="true" />
        <referenceBlock name="no_credit_banners" remove="true" />
        <referenceBlock name="sizing.calculator.button" remove="true" />
        <referenceBlock name="sticky.addtocart" remove="true" />
    </body>
</page>
