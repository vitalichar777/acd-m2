<?xml version="1.0" ?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
	<table name="map_discount" resource="default" engine="innodb" comment="tcs map_discount Table">
		<column xsi:type="int" name="product_id" padding="10" unsigned="true" nullable="false" comment="Product entity id"/>
		<column name="sku" nullable="true" xsi:type="varchar" comment="Product SKU" />
		<column name="rule_id" nullable="true" xsi:type="int" comment="sales rule id" />
		<column name="discount_type" nullable="true" xsi:type="varchar" comment="discount type fixed or percent" />
		<column name="discount" nullable="true" xsi:type="float" comment="discount percent or amount" />
		<column name="customer_group" nullable="true" xsi:type="varchar" comment="rule customer group" />
		<constraint xsi:type="primary" referenceId="PRIMARY">
			<column name="product_id"/>
		</constraint>
	</table>
</schema>