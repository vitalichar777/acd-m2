<?php
/**
 * Template for displaying products list widget
 *
 * @var $block \Magento\CatalogWidget\Block\Product\ProductsList
 */
?>
<?php if ($exist = ($block->getProductCollection() && $block->getProductCollection()->getSize())):?>
<?php
$_productCollection = $block->getLoadedProductCollection();
$_helper = $this->helper('Magento\Catalog\Helper\Output');
$_imagehelper = $this->helper('Magento\Catalog\Helper\Image');
$mapHelper = $this->helper('Thecommerceshop\Map\Helper\Data');

$_category_config = $this->helper('Smartwave\Porto\Helper\Data')->getConfig('porto_settings/category');
$_category_grid_config = $this->helper('Smartwave\Porto\Helper\Data')->getConfig('porto_settings/category_grid');
?>
<?php
    $type = 'widget-product-grid';

    $mode = 'grid';

    $image = 'new_products_content_widget_grid';
    $hover_image = 'category_page_grid-hover';
    $title = $block->getTitle() ? __($block->getTitle()) : '';
    $items = $block->getProductCollection()->getItems();

    $showWishlist = false; // Redesign: hide wishlist/compare on widget cards for now (were overlapping the CTA)
    $showCompare = false;
    $showCart = true;
    $templateType = \Magento\Catalog\Block\Product\ReviewRendererInterface::DEFAULT_VIEW;
    $description = false;

    $image_width = ($_category_config['ratio_width'])?$_category_config['ratio_width']:300;
    $image_height = ($_category_config['ratio_height'])?$_category_config['ratio_height']:300;
?>
    <?php /* Redesign card CSS (blue "View & Buy Now" + red compare / green sale) — same carrier the category list uses.
             The widget can render on pages without the catalog_category_view handle, so embed it here. */ ?>
    <?php echo $this->getLayout()->createBlock(\Magento\Framework\View\Element\Template::class)->setTemplate('Thecommerceshop_Pdpnewdesign::product/list/lowest_price_popup.phtml')->toHtml(); ?>
    <style>
    /* Redesign: widget product cards — full-width "View & Buy Now" (wishlist/compare removed for now) */
    /* override the theme constraints that break the full-width CTA */
    .products-grid .product-item-details .product-item-actions { margin: 0 !important; }
    .cms-page-view .products-grid .product-item-details .product-item-actions .actions-primary { width: 100% !important; }
    .block-products-list .product-item-actions { width: 100%; margin: 0; }
    .block-products-list .product-item-actions .actions-primary,
    .block-products-list .product-item-actions .tcs-bt-quickview { width: 100%; display: block; float: none; }
    .block-products-list .tcs-bt-quickview .tcs-viewbuy { width: 100%; font-size: 14px !important; }
    </style>
    <div class="block widget block-products-list <?php /* @escapeNotVerified */ echo $mode; ?>">
        <?php if ($title):?>
        <div class="block-title">
            <strong><?php /* @escapeNotVerified */ echo $title; ?></strong>
        </div>
        <?php endif ?>
        <div class="block-content">
            <?php /* @escapeNotVerified */ echo '<!-- ' . $image . '-->' ?>
            <div class="products-grid products-<?php /* @escapeNotVerified */ echo $mode; ?> <?php /* @escapeNotVerified */ echo $mode; ?>">
                <ol class="filterproducts products list items product-items <?php /* @escapeNotVerified */ echo $type; ?>">
                    <?php $iterator = 1; ?>
                    <?php foreach ($items as $_item): ?>
                        <?php /* @escapeNotVerified */ echo($iterator++ == 1) ? '<li class="item product product-item">' : '</li><li class="item product product-item">' ?>
                        <div class="product-item-info type1" data-container="product-grid" id="product-item-info_<?php echo $_item->getId();?>">
                            <a href="<?php echo $_item->getProductUrl() ?>" class="product photo product-item-photo" tabindex="-1">
                                <?php
                                    if($_category_config['aspect_ratio'])
                                        $productImage = $_imagehelper->init($_item, $image)->constrainOnly(FALSE)->keepAspectRatio(TRUE)->keepFrame(FALSE)->resize($image_width);
                                    else
                                        $productImage = $_imagehelper->init($_item, $image)->resize($image_width, $image_height);
                                    $productImageUrl = $productImage->getUrl();
                                ?>
                                    <img loading="lazy" class="product-image-photo default_image" src="<?php echo $productImageUrl; ?>" alt="<?php echo $productImage->getLabel(); ?>"/>
                                <?php if($_category_config['alternative_image']): ?>
                                <?php
                                    if($_category_config['aspect_ratio'])
                                        $productHoverImage = $_imagehelper->init($_item, $hover_image)->constrainOnly(FALSE)->keepAspectRatio(TRUE)->keepFrame(FALSE)->resize($image_width);
                                    else
                                        $productHoverImage = $_imagehelper->init($_item, $hover_image)->resize($image_width, $image_height);
                                    $productHoverImageUrl = $productHoverImage->getUrl();
                                ?>
                                    <?php if($productImageUrl != str_replace("/thumbnail/","/small_image/",$productHoverImageUrl)): ?>
                                    <img loading="lazy" class="product-image-photo hover_image" src="<?php echo $productHoverImageUrl; ?>" alt="<?php echo $productHoverImage->getLabel(); ?>"/>
                                    <?php endif; ?>
                                <?php endif; ?>
                            </a>
                            <div class="product-item-details">
                                <strong class="product-item-name">
                                    <a title="<?php echo $block->escapeHtml($_item->getName()) ?>"
                                       href="<?php /* @escapeNotVerified */ echo $block->getProductUrl($_item) ?>"
                                       class="product-item-link">
                                        <?php echo $block->escapeHtml($_item->getName()) ?>
                                    </a>
                                </strong>

                                <?php if($_category_config['rating_star']): ?>
                                <?php
                                    $review_html = $block->getReviewsSummaryHtml($_item, $templateType);
                                ?>
                                <?php if($review_html): ?>
                                    <?php echo $review_html; ?>
                                <?php else: ?>
                                <div class="product-reviews-summary short">
                                    <div class="rating-summary">
                                        <span class="label"><span>Rating:</span></span>
                                        <div class="rating-result" title="0%">
                                            <span style="width:0"><span>0%</span></span>
                                        </div>
                                    </div>
                                </div>
                                <?php endif; ?>
                                <?php endif; ?>
                                <?php
                                    /* Redesign card price (matches the category list.phtml cards):
                                       Goodman/Daikin/MrCool reveal the sale (compare struck + green sale);
                                       all other brands show the red slashed compare price only. */
                                    $__isOpen = (stripos($_item->getName(), 'goodman') !== false) || (stripos($_item->getName(), 'daikin') !== false) || (stripos($_item->getName(), 'mrcool') !== false);
                                    $__isMap  = ($mapHelper->getMapCategoryId() && in_array($mapHelper->getMapCategoryId(), $_item->getCategoryIds())) && (!$_item->getSpecialPrice() > 0);
                                    $__reg    = $_item->getPriceInfo()->getPrice('regular_price')->getAmount()->getValue();
                                    if($__isMap){
                                        $__sale = (float)$mapHelper->getRuleDiscountforCustomAmount($_item->getId(), $__reg);
                                    } else {
                                        $__sale = (float)$_item->getPriceInfo()->getPrice('final_price')->getAmount()->getValue();
                                    }
                                    $__hasSale = ($__sale > 0 && $__sale < $__reg);
                                ?>
                                <?php if($_category_config['product_price']): ?>
                                <div class="tcs-card-price">
                                    <?php if($__isOpen): ?>
                                        <?php if($__hasSale): ?>
                                            <span class="tcs-card-price__compare">$<?php echo number_format($__reg, 2); ?></span>
                                            <span class="tcs-card-price__sale">$<?php echo number_format($__sale, 2); ?></span>
                                        <?php else: ?>
                                            <span class="tcs-card-price__sale">$<?php echo number_format($__reg, 2); ?></span>
                                        <?php endif; ?>
                                    <?php else: ?>
                                        <span class="tcs-card-price__compare">$<?php echo number_format($__reg, 2); ?></span>
                                    <?php endif; ?>
                                </div>
                                <?php endif; ?>
                                <div id='saving-price-label-<?php echo $_item->getId()?>' style = "color: #0c0;font-weight: bold;"></div>
                                <script>
                                    var PriceBox = document.querySelector('[data-price-box="product-id-<?php echo $_item->getId()?>"]');
                                    if((PriceBox != null || PriceBox != undefined) && (PriceBox.querySelector('.minimal-price') != null || PriceBox.querySelector('.minimal-price') !=undefined)){
                                        var newPrice = PriceBox.querySelector('.minimal-price #old-price-<?php echo $_item->getId()?>-widget-product-grid span');
                                        var oldPrice = PriceBox.querySelector('.old-price #old-price-<?php echo $_item->getId()?>-widget-product-grid span');
                                        var savingPrice =  Number(oldPrice.innerHTML.replace(/[^0-9.-]+/g,"")) - Number(newPrice.innerHTML.replace(/[^0-9.-]+/g,""));
                                        var savingText = 'You Save: $'+parseFloat(savingPrice).toFixed(2)+'!';
                                        document.getElementById('saving-price-label-<?php echo $_item->getId()?>').innerHTML = savingText;
                                    }
                                </script>
                                <?php if($_category_config['actions']): ?>
                                <?php if ($showWishlist || $showCompare || $showCart): ?>
                                    <div class="product-item-actions">
                                        <?php if($_category_config['addtowishlist']): ?>
                                            <?php if ($this->helper('Magento\Wishlist\Helper\Data')->isAllow() && $showWishlist): ?>
                                                <a href="#"
                                                   data-post='<?php /* @escapeNotVerified */ echo $block->getAddToWishlistParams($_item); ?>'
                                                   class="action towishlist actions-secondary" data-action="add-to-wishlist"
                                                   title="<?php /* @escapeNotVerified */ echo __('Add to Wish List') ?>">
                                                    <span><?php /* @escapeNotVerified */ echo __('Add to Wish List') ?></span>
                                                </a>
                                            <?php endif; ?>
                                        <?php endif; ?>
                                        <?php $pUrl = $block->getAddToCartUrl($_item) ?>
                                        <?php if($_item->getTypeId() == 'bundle'){
                                            $pUrl = $block->getProductUrl($_item);
                                        }?>
                                        <?php if ($showCart): ?>
                                            <div class="actions-primary">
                                                <?php if ($_item->isSaleable()): ?>
                                                    <?php $postParams = $block->getAddToCartPostParams($_item); ?>
                                                    <?php if (($mapHelper->getMapCategoryId() && in_array($mapHelper->getMapCategoryId(), $_item->getCategoryIds())) && (!$_item->getSpecialPrice() > 0)){ ?>
                                                        <div id="quickview-<?php echo $_item->getId()?>" class="tcs-bt-quickview">
                                                            <a data-id="<?php echo $_item->getId()?>" class="tcs-viewbuy btn btn-action action primary" href="<?php echo $_item->getProductUrl(); ?>">
                                                                <span class="tcs-viewbuy__text">View &amp; Buy Now</span>
                                                                <span class="tcs-viewbuy__arrow"><svg xmlns="http://www.w3.org/2000/svg" width="25" height="12" viewBox="0 0 25 12" fill="none"><path d="M24.5303 6.05328C24.8232 5.76039 24.8232 5.28551 24.5303 4.99262L19.7574 0.219648C19.4645 -0.073245 18.9896 -0.073245 18.6967 0.219648C18.4038 0.512542 18.4038 0.987415 18.6967 1.28031L22.9393 5.52295L18.6967 9.76559C18.4038 10.0585 18.4038 10.5334 18.6967 10.8263C18.9896 11.1191 19.4645 11.1191 19.7574 10.8263L24.5303 6.05328ZM0 5.52295V6.27295H24V5.52295V4.77295H0V5.52295Z" fill="#F7D23D"/></svg></span>
                                                            </a>
                                                        </div>
                                                    <?php }else{ ?>
                                                        <form data-role="tocart-form" action="<?php echo $postParams['action'] ;?>" method="post">
                                                            <input type="hidden" name="product" value="<?php echo $postParams['data']['product']; ?>">
                                                            <input type="hidden" name="<?php echo Action::PARAM_NAME_URL_ENCODED; ?>" value="<?php echo $postParams['data'][Action::PARAM_NAME_URL_ENCODED]; ?>">
                                                            <?php if(isset($_category_config['qty_field']) && $_category_config['qty_field']):?>
                                                                <div class="qty-box">
                                                                    <a href="javascript:void(0)" class="qtyminus"><i class="porto-icon-minus"></i></a>
                                                                    <input type="text" name="qty" id="qty" maxlength="12" value="<?php /* @escapeNotVerified */ echo $block->getProductDefaultQty() * 1 ?>" title="<?php /* @escapeNotVerified */ echo __('Qty') ?>" class="input-text qty" data-validate="<?php echo $block->escapeHtml(json_encode($block->getQuantityValidators())) ?>"/>
                                                                    <a href="javascript:void(0)" class="qtyplus"><i class="porto-icon-plus"></i></a>
                                                                </div>
                                                            <?php endif;?>
                                                            <?php echo $block->getBlockHtml('formkey')?>
                                                            <button type="submit"
                                                                    title="<?php echo $block->escapeHtml(__('Add to Cart')); ?>"
                                                                    class="action tocart primary">
                                                                <span><?php  echo $block->escapeHtml(__('Add to Cart')); ?> </span>
                                                            </button>
                                                        </form>
                                                    <?php  } ?>
                                                <?php else: ?>
                                                    <?php if ($_item->getIsSalable()): ?>
                                                        <div class="stock available"><span><?php /* @escapeNotVerified */ echo __('In stock') ?></span></div>
                                                    <?php else: ?>
                                                        <div class="stock unavailable"><span><?php /* @escapeNotVerified */ echo __('Out of stock') ?></span></div>
                                                    <?php endif; ?>
                                                <?php endif; ?>
                                            </div>
                                        <?php endif; ?>
                                        <?php if($_category_config['addtocompare']): ?>
                                            <?php if ($block->getAddToCompareUrl() && $showCompare): ?>
                                                <?php $compareHelper = $this->helper('Magento\Catalog\Helper\Product\Compare');?>
                                                <a href="#" class="action tocompare actions-secondary"
                                                   data-post='<?php /* @escapeNotVerified */ echo $compareHelper->getPostDataParams($_item);?>'
                                                   title="<?php /* @escapeNotVerified */ echo __('Add to Compare') ?>">
                                                    <span><?php /* @escapeNotVerified */ echo __('Add to Compare') ?></span>
                                                </a>
                                            <?php endif; ?>
                                        <?php endif; ?>
                                    </div>
                                <?php endif; ?>
                                <?php endif; ?>
                            </div>
                        </div>
                        <?php echo($iterator == count($items)+1) ? '</li>' : '' ?>
                    <?php endforeach ?>
                </ol>
            </div>
            <?php echo $block->getPagerHtml() ?>
        </div>
    </div>
<?php endif;?>
