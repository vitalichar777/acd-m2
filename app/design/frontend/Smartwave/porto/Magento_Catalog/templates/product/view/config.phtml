<?php
    $porto_helper = $this->helper('Smartwave\Porto\Helper\Data');
    $move_upsell = $porto_helper->getConfig('porto_settings/product/move_upsell');
    $move_addtolinks = $porto_helper->getConfig('porto_settings/product/move_addtolinks');
    $tab_fullbg = $porto_helper->getConfig('porto_settings/product/tab_full_background');
    $uppsell_fullbg = $porto_helper->getConfig('porto_settings/product/move_upsell_full');
?>
<script type="text/javascript">
require([
    'jquery'
], function ($) {
    $(document).ready(function(){
        if(!($("body").hasClass("product-type-default") || $("body").hasClass("product-type-carousel") || $("body").hasClass("product-type-fullwidth") || $("body").hasClass("product-type-grid") || $("body").hasClass("product-type-sticky-right") || $("body").hasClass("product-type-wide-grid"))) {
    <?php if($move_upsell): ?>
        $(".product.media").after($(".block.upsell").detach());
    <?php endif; ?>
    <?php if($tab_fullbg):?>
        var m = $('<div class="main-product-detail"/>');
        $('<div class="container"/>').html($(".move-product-tab").detach()).appendTo(m);
        $("#maincontent").after(m);
        <?php if(!$move_upsell): ?>
        $(".main-product-detail").after($('<div class="container"/>').html($(".block.upsell").detach()));
        <?php endif; ?>
    <?php endif;?>
    <?php if($uppsell_fullbg && !$move_upsell && !$tab_fullbg):?>
        /* Redesign: upsell is positioned server-side via layout (catalog_product_view_pdpnewdesign.xml). JS move intentionally disabled. */
    <?php endif;?>
        }
    <?php if($move_addtolinks): ?>
        $(".box-tocart .actions").after('<div class="moved-add-to-links"></div>');
        $(".product-social-links > .product-addto-links").appendTo(".moved-add-to-links");
        $(".product-social-links > .action.mailto").appendTo(".moved-add-to-links");
    <?php endif; ?>
    });
});
</script>
<style>
/* Redesign: upsell section transparent (was #f4f4f4) and no negative overlap margin */
.main-upsell-product-detail { background: transparent !important; background-color: transparent !important; margin-top: 0 !important; }
/* Description tabs (accordion) h2 typography — desktop + mobile */
.product.info.detailed .data.item.content h2 { font-weight: bold; font-size: 2rem; padding-bottom: 12px; }
@media (max-width: 767.98px) {
    /* Reduce spacing before the upsell ("Products you might need") on mobile */
    .main-upsell-product-detail { padding-top: 12px !important; padding-bottom: 20px !important; }
}
</style>
<script>
    window.pagesense = window.pagesense || [];
    window.pagesense.push(['trackEvent', 'Product']);
</script>
